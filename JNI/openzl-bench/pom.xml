<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.th3n3wn00b</groupId>
        <artifactId>openzl-jni-parent</artifactId>
        <version>0.3.3</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>openzl-bench</artifactId>
    <packaging>jar</packaging>

    <name>OpenZL Benchmark Suite</name>
    <description>Extensible protobuf benchmark comparing OpenZL, gzip, and pure protobuf paths.</description>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>openzl-jni</artifactId>
            <version>${project.version}</version>
            <classifier>linux_amd64</classifier>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>openzl-utils</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.luben</groupId>
            <artifactId>zstd-jni</artifactId>
        </dependency>
        <dependency>
            <!-- org.lz4:lz4-java is unmaintained (CVE-2025-12183); at.yawk.lz4 is the maintained drop-in. -->
            <groupId>at.yawk.lz4</groupId>
            <artifactId>lz4-java</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <configuration>
                    <mainClass>io.github.hybledav.bench.protobuf.ProtobufCodecBenchMain</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
